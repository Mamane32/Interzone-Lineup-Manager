# --- Supabase Auth (administrator sign-in) ---------------------------------
# Public project URL and anon key — used only to check/establish the
# administrator's session (sign in, sign out). Safe to expose to the browser;
# every table's Row Level Security has no public policies, so the anon key
# alone cannot read or write any application data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase service role (server-only, all application data) ------------
# Used exclusively from Server Components / Server Actions to read and write
# competitions, teams, players, matches, and lineups. Never expose this key
# to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used to build the coach's private links (e.g. https://lineup.interzone.ht)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Broadcast Control Center branding (all optional) ----------------------
# None of these are required — every one has a safe generic fallback. Set
# them to relabel the Broadcast Control Center for a specific organization
# or production partner without touching any code (see lib/branding.ts and
# SPRINT_2_1_LIVE_CENTER_UPGRADE.md). "Powered by GoodGrafik" is permanent
# and is not configurable here by design.
# NEXT_PUBLIC_BROADCAST_ORG_NAME=Interzone
# NEXT_PUBLIC_BROADCAST_ORG_LOGO_URL=
# NEXT_PUBLIC_BROADCAST_SEASON_NAME=2026 Season
# NEXT_PUBLIC_BROADCAST_PARTNER_NAME=Media Tout Kote
# NEXT_PUBLIC_BROADCAST_PARTNER_LOGO_URL=

# --- vMix integration (optional, server-only) -------------------------------
# Unset by default in every environment — the Broadcast Control Center shows
# vMix as "Not Configured" (honestly, not as an error) until these are set to
# a real, reachable vMix instance's HTTP API. See VMIX_INTEGRATION.md.
# VMIX_HOST=192.168.1.50
# VMIX_PORT=8088
