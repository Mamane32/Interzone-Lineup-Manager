# ============================================================================
# GGSP — Vercel staging environment variables
# ============================================================================
# Copy each KEY into Vercel → Project Settings → Environment Variables,
# scoped to whichever environment staging deploys through (Preview, or a
# custom "Staging" environment on plans that support it). Do NOT paste this
# whole file in as one blob if your Vercel UI expects one variable per
# entry — add them one at a time, or use `vercel env add` per key.
#
# All five REQUIRED values below come from the NEW staging Supabase
# project (Project Settings → API), not the existing/production one.
# Never reuse the existing project's keys here — that would point staging
# at production data.
#
# NEXT_PUBLIC_* values are baked into the client bundle at BUILD time, not
# read at request time. Set these correctly BEFORE the first deploy; if
# you change one later, trigger a new deploy — a redeploy of the same
# build will not pick up the change.

# --- Required -----------------------------------------------------------

# Project Settings -> API -> Project URL (staging project)
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co

# Project Settings -> API -> Project API keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=<staging-anon-key>

# Same Project URL as above, server-side name (identical value, different var name)
SUPABASE_URL=https://<staging-project-ref>.supabase.co

# Project Settings -> API -> Project API keys -> service_role
# SECRET — server-only. Never prefix with NEXT_PUBLIC_. Never log it.
SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key>

# The staging app's own public URL, no trailing slash. Must exactly match
# the "Site URL" you set in Supabase Auth -> URL Configuration.
NEXT_PUBLIC_APP_URL=https://<your-staging-domain>

# --- Optional — Broadcast Center branding overrides ----------------------
# Every one has a safe generic fallback if left unset. Set only if this
# staging environment should visually represent a specific org/season for
# QA purposes.
# NEXT_PUBLIC_BROADCAST_ORG_NAME=Interzone
# NEXT_PUBLIC_BROADCAST_ORG_LOGO_URL=
# NEXT_PUBLIC_BROADCAST_SEASON_NAME=2026 Season
# NEXT_PUBLIC_BROADCAST_PARTNER_NAME=Media Tout Kote
# NEXT_PUBLIC_BROADCAST_PARTNER_LOGO_URL=

# --- Optional — vMix integration -----------------------------------------
# Unset by default in every environment. Broadcast Center shows vMix as
# "Not Configured" (an honest state, not an error) until both are set to
# a real, reachable vMix instance's HTTP API.
# VMIX_HOST=192.168.1.50
# VMIX_PORT=8088

# --- Do NOT set on Vercel --------------------------------------------------
# SUPABASE_DB_URL — a direct Postgres connection string with full database
# access. Only used locally/manually for running migration and bootstrap
# SQL via `psql`. The deployed app never reads this variable at runtime;
# adding it to Vercel would needlessly expose full DB credentials to the
# app's server process for no functional benefit.
